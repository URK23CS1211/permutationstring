using System;

class Program
{
    static void Permute(string str, int start)
    {
        if (start == str.Length - 1)
        {
            Console.WriteLine(str);
            return;
        }

        for (int i = start; i < str.Length; i++)
        {
            char[] arr = str.ToCharArray();

            char temp = arr[start];
            arr[start] = arr[i];
            arr[i] = temp;

            Permute(new string(arr), start + 1);
        }
    }

    static void Main()
    {
        string str = "ABC";

        Permute(str, 0);
    }
}
